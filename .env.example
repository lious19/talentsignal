# Copy to .env and adjust if needed. Never commit the real .env file.

POSTGRES_USER=talentsignal
POSTGRES_PASSWORD=talentsignal
POSTGRES_DB=talentsignal

BACKEND_PORT=4000
FRONTEND_PORT=5173
# Host-side mapping only — container-to-container traffic always uses 5432
# on the internal Docker network. 5433 avoids colliding with a native
# Postgres already running on the host at 127.0.0.1:5432.
DB_PORT=5433

LOG_LEVEL=info
CORS_ORIGIN=*
