# Copy to .env and adjust if needed. Never commit the real .env file.

POSTGRES_USER=talentsignal
POSTGRES_PASSWORD=talentsignal
POSTGRES_DB=talentsignal

BACKEND_PORT=4000
FRONTEND_PORT=5173
# Host-side mapping only — container-to-container traffic always uses 5432
# on the internal Docker network. 5433 avoids colliding with a native
# Postgres already running on the host at 127.0.0.1:5432.
DB_PORT=5433

LOG_LEVEL=info
CORS_ORIGIN=*

# Required — the backend refuses to boot without a real value here (see
# 06_decisions/002-jwt-lifetime.md). Generate one with: openssl rand -base64 32
JWT_SECRET=

# Optional. Set both to create exactly one bootstrap admin account on boot.
# Leave blank (default) and no admin account is created — see
# 06_decisions/003-admin-bootstrap-and-self-registration-role.md
ADMIN_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
